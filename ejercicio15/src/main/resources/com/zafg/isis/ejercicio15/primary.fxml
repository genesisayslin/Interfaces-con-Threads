<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.zafg.isis.ejercicio15.PrimaryController">
    <children>
        <Label text="Alimentación" />
        <TextField fx:id="txtAlimentacion" />

        <Label text="Refrigerios" />
        <TextField fx:id="txtRefrigerios" />

        <Label text="Transporte" />
        <TextField fx:id="txtTransporte" />

        <Label text="Telefonía" />
        <TextField fx:id="txtTelefonia" />

        <Label text="Otros" />
        <TextField fx:id="txtOtros" />

        <Button text="Calcular estadísticas" onAction="#calcular" />
        <Button text="Limpiar" onAction="#limpiar" />

        <Label text="Estadísticas" />
        <Label text="Total semanal" />
        <TextField fx:id="txtTotal" />

        <Label text="Gasto más alto" />
        <TextField fx:id="txtMasAlto" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>